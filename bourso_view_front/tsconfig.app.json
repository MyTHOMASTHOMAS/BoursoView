{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Root — allow imports from parent (external packages) */
    "rootDir": "../",
    "baseUrl": ".",
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules"
    ],
    /* Path Aliases */
    "paths": {
      "MypkgReact/*": [
        "../mypkg_packages_react/*"
      ],
      "MypkgTypescript/*": [
        "../mypkg_packages_typescript/*"
      ],
      "Shared/*": [
        "../shared/*"
      ]
    },
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src",
    "../mypkg_packages_react",
    "../mypkg_packages_typescript",
    "../shared"
  ]
}